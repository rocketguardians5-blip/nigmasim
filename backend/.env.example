# NigmaSim Environment Configuration Example
# Copy this file to .env and adjust values as needed.
# JANGAN commit file .env ke repository (berisi secret).

# ========== Aplikasi ==========
APP_NAME=NigmaSim
APP_ENV=development
APP_DEBUG=true
APP_BASE_URL=http://localhost:8000
API_PREFIX=/api/v1

# ========== Keamanan ==========
# GANTI dengan secret yang kuat & random di production (min 32 char untuk HS256)
SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ========== Bootstrap Admin ==========
ADMIN_EMAIL=admin@nigmasim.com
ADMIN_NAME=Super Administrator
ADMIN_INITIAL_PASSWORD=Admin#12345

# ========== Database ==========
DATABASE_URL=sqlite:///./nigmasim.db

# Development only: izinkan mendaftarkan aplikasi pada host internal (localhost)
# WAJIB false di production.
ALLOW_PRIVATE_HOSTS_IN_REGISTRY=false

# ========== Storage ==========
STORAGE_ROOT=./storage
MAX_SCREENSHOT_MB=25

# ========== Simulation Runtime (Stage 2) ==========
# Folder workspace runtime React. Generator menulis apps/<slug>/ dan registry.json di sini.
SIMULATION_RUNTIME_ROOT=../simulation-runtime

# ========== Capture Worker ==========
CAPTURE_WORKER_URL=http://127.0.0.1:8010
CAPTURE_WORKER_TOKEN=dev-only-worker-token
CAPTURE_HEADLESS=false

# ========== Google Gemini (AI Vision) ==========
# API Key dari Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Model utama untuk analisis screenshot (vision).
# HANYA dua model diizinkan: gemini-3.8-flash, gemini-3.6-flash
# Backend akan GAGAL START jika model di luar daftar ini.
GEMINI_MODEL=gemini-3.6-flash

# Model cadangan (fallback), dipisah koma. Hanya dipakai jika GEMINI_ALLOW_FALLBACK=true.
# Harus salah satu dari daftar model diizinkan, dan TIDAK BOLEH sama dengan GEMINI_MODEL.
# Kosongkan untuk menonaktifkan fallback.
GEMINI_FALLBACK_MODELS=

# Aktifkan fallback ke model cadangan saat model utama gagal (429/503/timeout).
# Default: false (OFF). Saat false, model utama akan di-retry dengan backoff,
# dan error akan dikembalikan eksplisit tanpa diam-diam memakai model cadangan.
GEMINI_ALLOW_FALLBACK=false

# Jumlah maksimum retry untuk model utama saat 429/503/timeout.
# Setiap retry menggunakan exponential backoff: base_delay * 3^attempt.
GEMINI_MAX_RETRIES=3

# Base delay untuk retry (detik). Delay sequence: 5s, 15s, 45s, ... (dikalikan 3 setiap retry).
GEMINI_RETRY_BASE_DELAY=5.0

# Maksimum delay untuk retry (detik). Mencegah backoff terlalu lama.
GEMINI_RETRY_MAX_DELAY=60.0

# Base URL API Gemini. Biasanya tidak perlu diubah.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta