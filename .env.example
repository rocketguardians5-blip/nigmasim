# ============================================================
# NigmaSim — contoh konfigurasi
# Salin menjadi .env lalu isi nilainya. JANGAN commit file .env.
# ============================================================

# ---------- Aplikasi ----------
APP_NAME=NigmaSim
APP_ENV=development
APP_DEBUG=true
APP_BASE_URL=http://localhost:8000

# ---------- Keamanan ----------
# WAJIB diganti di setiap environment. Hasilkan dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=GANTI_DENGAN_RANDOM_48_BYTE
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_SCHEME=argon2
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# ---------- Database ----------
# MVP: SQLite. Untuk PostgreSQL ganti ke:
#   postgresql+psycopg://user:pass@localhost:5432/nigmasim
DATABASE_URL=sqlite:///./nigmasim.db

# ---------- Storage ----------
STORAGE_ROOT=./storage
MAX_SCREENSHOT_MB=25

# ---------- Capture Worker ----------
# Worker hanya listen di loopback. Jangan diekspos ke internet.
CAPTURE_WORKER_URL=http://127.0.0.1:8010
CAPTURE_WORKER_TOKEN=GANTI_DENGAN_RANDOM_TOKEN
CAPTURE_HEADLESS=false
CAPTURE_DEFAULT_VIEWPORT_WIDTH=1440
CAPTURE_DEFAULT_VIEWPORT_HEIGHT=900

# Domain yang diizinkan untuk di-capture (allowlist, pisahkan dengan koma).
# Kosong = tidak ada yang diizinkan. Isi hanya setelah ada otorisasi.
CAPTURE_ALLOWED_HOSTS=

# ---------- Frontend ----------
# Tidak dipakai backend; dipakai Vite. Lihat frontend/.env.example
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:5173"]
