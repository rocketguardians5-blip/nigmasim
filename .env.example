# ============================================================
# NigmaSim — contoh konfigurasi
# Salin menjadi .env lalu isi nilainya. JANGAN commit file .env.
# ============================================================

# ---------- Aplikasi ----------
APP_NAME=NigmaSim
APP_ENV=development
APP_DEBUG=true
APP_BASE_URL=http://localhost:8000

# ---------- Keamanan ----------
# WAJIB diganti di setiap environment. Hasilkan dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=GANTI_DENGAN_RANDOM_48_BYTE
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_SCHEME=argon2
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# ---------- Database ----------
# MVP: SQLite. Untuk PostgreSQL ganti ke:
#   postgresql+psycopg://user:pass@localhost:5432/nigmasim
DATABASE_URL=sqlite:///./nigmasim.db

# ---------- Storage ----------
# WAJIB path absolut supaya backend (backend/) dan capture worker (capture-worker/src/)
# menulis ke tempat yang sama.
STORAGE_ROOT=C:/Users/Lenovo/nigmasim/storage
MAX_SCREENSHOT_MB=25

# ---------- Capture Worker ----------
# Worker hanya listen di loopback. Jangan diekspos ke internet.
CAPTURE_WORKER_URL=http://127.0.0.1:8010
CAPTURE_WORKER_TOKEN=GANTI_DENGAN_RANDOM_TOKEN
CAPTURE_HEADLESS=false
CAPTURE_DEFAULT_VIEWPORT_WIDTH=1440
CAPTURE_DEFAULT_VIEWPORT_HEIGHT=900

# Development saja: izinkan mendaftarkan aplikasi pada host internal (127.0.0.1)
# supaya alur capture bisa diuji tanpa aplikasi produksi. WAJIB false di production.
ALLOW_PRIVATE_HOSTS_IN_REGISTRY=false

# ---------- Akun admin awal ----------
# Dibuat otomatis saat backend pertama kali jalan.
ADMIN_EMAIL=admin@nigmasim.com
ADMIN_NAME=Super Administrator
ADMIN_INITIAL_PASSWORD=GANTI_PASSWORD_INI

# Domain yang diizinkan untuk di-capture (allowlist, pisahkan dengan koma).
# Kosong = tidak ada yang diizinkan. Isi hanya setelah ada otorisasi.
CAPTURE_ALLOWED_HOSTS=

# ---------- Model AI (opsional, untuk Fase 3f: analisis screenshot) ----------
# Kalau dikosongkan, NigmaSim memakai mesin analisis berbasis aturan (sudah jalan).
# Token WAJIB disimpan di .env (sudah masuk .gitignore) - JANGAN di-commit.
#
# Contoh Gemini (Google AI Studio - https://aistudio.google.com/apikey):
#   AI_PROVIDER=gemini
#   AI_API_KEY=...
#   AI_MODEL=gemini-2.0-flash
#
# Contoh OpenRouter (satu kunci untuk banyak model):
#   AI_PROVIDER=openrouter
#   AI_API_KEY=...
#   AI_MODEL=google/gemini-2.0-flash
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# ---------- Frontend ----------
# Tidak dipakai backend; dipakai Vite. Lihat frontend/.env.example
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:5173"]
