# ===== NigmaSim Environment Variables =====
# Copy to .env and fill in the values

# ---------- Application ----------
APP_NAME=NigmaSim
APP_ENV=development
APP_DEBUG=true
APP_BASE_URL=http://localhost:8000
API_PREFIX=/api/v1

# ---------- Security ----------
# Ganti dengan secret yang aman (min 32 char) untuk production!
SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173

# ---------- Bootstrap Admin ----------
ADMIN_EMAIL=admin@nigmasim.com
ADMIN_NAME=Super Administrator
ADMIN_INITIAL_PASSWORD=Admin#12345

# ---------- Database ----------
DATABASE_URL=sqlite:///./nigmasim.db

# ---------- Capture Worker ----------
CAPTURE_WORKER_URL=http://127.0.0.1:8010
CAPTURE_WORKER_TOKEN=dev-only-worker-token
CAPTURE_HEADLESS=false
CAPTURE_DEFAULT_VIEWPORT_WIDTH=1440
CAPTURE_DEFAULT_VIEWPORT_HEIGHT=900
CAPTURE_ALLOWED_HOSTS=

# ---------- NVIDIA NIM (AI Agent) ----------
# Dapatkan API key dari https://build.nvidia.com
# Format: nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_API_KEY=
# Model ID dari build.nvidia.com, contoh:
# - nvidia/nemotron-3-ultra
# - nvidia/llama-3.1-nemotron-70b-instruct
# - meta/llama-3.1-405b-instruct
NVIDIA_MODEL=nvidia/nemotron-3-ultra
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ---------- Google Gemini (AI Vision) ----------
# Dapatkan API key dari https://aistudio.google.com/apikey
# Format: AIza...
GEMINI_API_KEY=
# Model vision multimodal dari Google AI Studio
GEMINI_MODEL=gemini-3.8-flash
# Dipakai otomatis bila model utama 503/429/timeout (dipisah koma)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---------- Agent Settings ----------
AGENT_MAX_ROUNDS=5
AGENT_RATE_LIMIT_PER_MINUTE=10
AGENT_MAX_HISTORY_MESSAGES=20
AGENT_MAX_INPUT_CHARS=4000